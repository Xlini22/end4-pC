+// One history identity and one sample row per bar section, independent of nested cards.
+inline std::vector<SGlassRegion> glassBarDarkeningRegions(const std::vector<SGlassRegion>& regions) {
+    std::vector<SGlassRegion> sections;
+    for (int group = 1; group <= 3; ++group) {
+        const auto found = std::find_if(regions.begin(), regions.end(), [&](const auto& region) {
+            return region.darkeningGroup == group && region.opacity > 0;
+        });
+        if (found == regions.end()) continue;
+        SGlassRegion section;
+        section.id = -group; // Internal history IDs; IPC material IDs are strictly positive.
+        section.rect = found->darkeningBox;
+        section.samplePoints = group == 2 ? 3 : 2;
+        sections.push_back(section);
+    }
+    return sections;
+}

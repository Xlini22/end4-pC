new file mode 100644
index 0000000..add6129
--- /dev/null
+++ b/src/DarkeningWindow.hpp
@@ -0,0 +1,35 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+
+// Piecewise-constant integration of the previous sample on fixed wall-clock windows.
+struct SDarkeningWindow {
+    struct Step { float before = 0, after = 0; int windows = -1; };
+    static constexpr double PERIOD = 1.5, FADE = .8;
+    double start = 0, last = 0, changed = 0;
+    bool initialized = false, published = false;
+    void reset() { initialized = published = false; }
+    Step advance(double now) {
+        if (!initialized || now < last) {
+            start = last = changed = now; initialized = true; published = false;
+            return {};
+        }
+        const double elapsed = now - start;
+        const double windows = std::floor(elapsed / PERIOD);
+        Step step;
+        step.windows = windows > 1 ? 2 : int(windows);
+        if (windows >= 1) {
+            step.before = float(std::clamp((start + PERIOD - last) / PERIOD, 0.0, 1.0));
+            start += windows * PERIOD;
+            step.after = float(std::clamp((now - start) / PERIOD, 0.0, 1.0));
+            published = true;
+            changed = now;
+        } else step.before = float((now - last) / PERIOD);
+        last = now;
+        return step;
+    }
+    float blend(double now) const {
+        const float t = published ? float(std::clamp((now - changed) / FADE, 0.0, 1.0)) : 1;
+        return t * t * (3 - 2 * t);
+    }
+};

+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA32F, 33, 1, 0, GL_RGBA, GL_FLOAT, nullptr);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, state.framebuffers[index]);
+        glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, state.textures[index], 0);
+        if (glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+            state.failed = true;
+            return false;
+        }
+    }
+    return true;
+}

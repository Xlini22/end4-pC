+void CGlassLayerSurface::updateDarkeningVisibility() {
+    const auto layer = m_layerSurface.lock();
+    const auto* surface = enhancedSurface();
+    const bool visible = layer && layer->m_mapped && !layer->m_fadingOut && layer->m_alpha->value() >= .001f
+        && hasVisibleMaterial() && (!surface || surface->darkeningVisible);
+    if (visible != m_darkeningVisible) {
+        m_darkeningVisible = visible;
+        m_darkeningScenePending = false;
+        if (m_darkeningTimer) m_darkeningTimer->updateTimeout(std::nullopt);
+        if (visible) {
+            const double now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+            m_temporalDarkening.restart(now);
+        }
+    }
+    if (!visible) return;
+    const auto monitor = layer->m_monitor.lock();
+    if (!monitor) return;
+    for (const auto& workspace : {monitor->m_activeWorkspace, monitor->m_activeSpecialWorkspace}) {
+        if (workspace && (workspace->m_renderOffset->isBeingAnimated() || workspace->m_alpha->isBeingAnimated())) {
+            noteDarkeningSceneChange(false);
+            break;
+        }
+    }
+}
+
+void CGlassLayerSurface::noteDarkeningSceneChange(bool repaint) {
+    if (!m_darkeningVisible) return;
+    const double now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    // Reset once when an idle scene starts changing, never on every event/frame.
+    if (!m_darkeningScenePending) m_temporalDarkening.restart(now);
+    m_darkeningScenePending = true;
+    m_darkeningSceneChanged = now;
+    if (repaint) damageMaterial();
+}
+
+bool CGlassLayerSurface::needsDarkeningPublication() {
+    const auto& state = m_temporalDarkening;
+    if (!m_darkeningVisible || state.failed || !state.clock.initialized) return false;
+    // Drain the first complete window after the last external change; darker damage never marks the scene dirty.
+    if (m_darkeningScenePending && state.clock.start >= m_darkeningSceneChanged + SDarkeningWindow::PERIOD)
+        m_darkeningScenePending = false;
+    return !state.clock.published || m_darkeningScenePending;
+}
+
+void CGlassLayerSurface::scheduleDarkeningPublication() {
+    const auto& state = m_temporalDarkening;
+    if (!needsDarkeningPublication()) {
+        if (m_darkeningTimer) m_darkeningTimer->updateTimeout(std::nullopt);
+        return;
+    }
+    if (!m_darkeningTimer) {
+        m_darkeningTimer = makeShared<CEventLoopTimer>(std::nullopt, [this](SP<CEventLoopTimer>, void*) {
+            updateDarkeningVisibility();
+            if (needsDarkeningPublication()) damageMaterial();
+        }, nullptr);
+        g_pEventLoopManager->addTimer(m_darkeningTimer);
+    }
+    if (m_darkeningTimer->armed()) return;
+    const double now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    const auto delay = std::chrono::duration<double>(std::max(.001, state.clock.start + SDarkeningWindow::PERIOD - now));
+    m_darkeningTimer->updateTimeout(std::chrono::duration_cast<Time::steady_dur>(delay));
+}

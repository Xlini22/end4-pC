+
+static bool temporalBuffers(SAdaptiveDarkening& state) {
+    if (state.failed) return false;
+    if (state.textures[0]) return true;
+    glGenTextures(2, state.textures.data());
+    glGenFramebuffers(2, state.framebuffers.data());
+    if (!state.textures[0] || !state.textures[1] || !state.framebuffers[0] || !state.framebuffers[1]) {
+        state.failed = true; return false;
+    }
+    for (int index = 0; index < 2; ++index) {
+        glBindTexture(GL_TEXTURE_2D, state.textures[index]);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);

 #include <array>
 
 // Observe compositor opacity, not workspace activation: swipes reveal Top layers before committing.
+static void damageAdaptivePopups(PHLMONITOR monitor) {
+    if (!monitor || monitor->m_transform != WL_OUTPUT_TRANSFORM_NORMAL) return;
+    const auto incoming = monitor->m_damage.getBufferDamage(1);
+    if (incoming.empty()) return;
+    for (const auto& [ptr, state] : g_pGlobalState->layerSurfaces) {
+        const auto layer = state->getLayerSurface();
+        if (!layer || (!layer->m_mapped && !layer->m_fadingOut) || layer->m_monitor.lock() != monitor
+            || (layer->m_namespace != "quickshell:popup" && layer->m_namespace != "quickshell:popupMorph")) continue;
+        const auto* dimming = glassDarkeningOptics(layer->getPID(), "bar");
+        if (!dimming || dimming->darkeningValue()[1] <= 0) continue;
+        CBox popup{layer->m_realPosition->value(), layer->m_realSize->value()};
+        if (!std::isfinite(popup.x) || !std::isfinite(popup.y) || !std::isfinite(popup.w) || !std::isfinite(popup.h)
+            || popup.w <= 0 || popup.h <= 0) continue;
+        popup.translate(-monitor->m_position).scale(monitor->m_scale).round();
+        auto sample = popup;
+        sample.expand(GlassRenderer::SAMPLE_PADDING_PX * monitor->m_scale);
+        if (incoming.copy().intersect(sample).empty()) continue;
+        // Only expand an already requested frame, before its damage is consumed.
+        // Calling damageBox here would schedule another frame and sustain idle redraws.
+        monitor->m_damage.damage(popup);
+    }
+}

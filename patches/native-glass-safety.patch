+
+// Logical desktop coordinates, including conservative refraction/blur/AA support.
+inline std::optional<std::array<double, 4>> glassDamageBox(const SGlassSurface& surface,
+        const std::array<double, 4>& layer, double scale) {
+    if (!std::isfinite(scale) || scale <= 0 || !std::isfinite(surface.width) || !std::isfinite(surface.height)
+        || surface.width <= 0 || surface.height <= 0) return std::nullopt;
+    for (double value : layer) if (!std::isfinite(value)) return std::nullopt;
+    if (layer[2] <= 0 || layer[3] <= 0) return std::nullopt;
+    const auto bounds = glassBounds(surface);
+    if (!bounds) return std::nullopt;
+    const double sx = layer[2] / surface.width, sy = layer[3] / surface.height;
+    float frost = 0;
+    for (const auto& region : surface.regions) if (region.opacity > 0) frost = std::max(frost, region.frost);
+    // ponytail: one conservative rectangle per surface; disjoint materials need region-wise damage.
+    const double padding = std::max(80.0, 3 * frost * std::min(sx, sy)) + 2 / scale;
+    const double left = std::floor(layer[0] + (*bounds)[0] * sx - padding);
+    const double top = std::floor(layer[1] + (*bounds)[1] * sy - padding);
+    const double right = std::ceil(layer[0] + ((*bounds)[0] + (*bounds)[2]) * sx + padding);
+    const double bottom = std::ceil(layer[1] + ((*bounds)[1] + (*bounds)[3]) * sy + padding);
+    return std::array<double, 4>{left, top, right - left, bottom - top};
 }
 

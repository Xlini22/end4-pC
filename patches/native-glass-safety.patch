+inline const SGlassSurface* glassSurfaceForLayer(const SGlassClient& client, std::string_view name,
+        std::string_view monitor, double width, double height) {
+    const SGlassSurface* found = nullptr;
+    for (const auto& surface : client.surfaces) {

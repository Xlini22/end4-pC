+            || std::abs(surface.height - height) > 2) continue;
+        // ponytail: ambiguous equal-sized layers retain the full fallback; unique IDs would remove this ceiling.
+        if (found) return nullptr;
+        found = &surface;
+    }
+    return found;
+}

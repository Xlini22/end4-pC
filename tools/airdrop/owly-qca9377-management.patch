+#[cfg(test)]
+mod management_tests {
+    #[test]
+    #[ignore = "requires OWLY_MGMT_CAPTURE pointing to a local iw management dump"]
+    fn captured_management_frames_confirm_peers() {
+        use super::*;
+        use owly_awdl::{Channel, Input, Node, Presence, RadioConstraints, Time};
+        let capture = std::fs::read_to_string(std::env::var("OWLY_MGMT_CAPTURE").unwrap()).unwrap();
+        let mut node = Node::new(
+            Config::new(
+                MacAddr([2, 0, 0, 0, 0, 1]),
+                "replay",
+                RadioConstraints {
+                    channel: Channel(6),
+                    presence: Presence::Fixed,
+                },
+            ),
+            Time(0),
+        );
+        let mut frame = Vec::new();
+        let mut count = 0;
+        let mut confirmed = 0;
+        for line in capture.lines().chain(std::iter::once("freq end")) {
+            if line.starts_with("freq ") && !frame.is_empty() {
+                count += 1;
+                node.handle(Input::Frame {
+                    rx_time: Time(count * 10_000),
+                    rssi: None,
+                    bytes: &frame,
+                })
+                .for_each(drop);
+                confirmed = confirmed.max(node.peers().filter(|p| p.valid).count());
+                frame.clear();
+            }
+            if let Some(hex) = line.strip_prefix("mgmt: ") {
+                frame.extend(
+                    hex.split_whitespace()
+                        .map(|b| u8::from_str_radix(b, 16).unwrap()),
+                );
+            }
+        }
+        eprintln!(
+            "replayed={count} rx_action={} malformed={} confirmed_peers={confirmed}",
+            node.stats().rx_action,
+            node.stats().rx_malformed
+        );
+        assert!(node.stats().rx_action > 0);
+        assert!(confirmed > 0);
+    }
+    use super::*;
+    use crate::netlink::{Attrs, align};
+
+    #[test]
+    fn vendor_management_events_are_bounded_and_keep_all_frames() {
+        let mut frame = vec![0; 31];
+        frame[0] = 0xd0;
+        frame[24..29].copy_from_slice(&[0x7f, 0, 0x17, 0xf2, 8]);
+        let mut attrs = Attrs::new();
+        attrs.u32(3, 7).bytes(51, &frame).u32(151, (-29i32) as u32);
+        let len = 20 + attrs.0.len();
+        let mut event = Vec::new();
+        event.extend_from_slice(&(len as u32).to_ne_bytes());
+        event.extend_from_slice(&32u16.to_ne_bytes());
+        event.extend_from_slice(&[0; 10]);
+        event.extend_from_slice(&[59, 0, 0, 0]);
+        event.extend_from_slice(&attrs.0);
+        event.resize(align(len), 0);
+        let expected = Received {
+            bytes: frame,
+            rssi: Some(-29),
+        };
+        assert_eq!(management_frames(&event, 7), vec![expected.clone()]);
+        assert!(management_frames(&event, 8).is_empty());
+        for end in 0..len {
+            assert!(management_frames(&event[..end], 7).is_empty());
+        }
+        let mut batch = event.clone();
+        batch.extend_from_slice(&event);
+        assert_eq!(
+            management_frames(&batch, 7),
+            vec![expected.clone(), expected]
+        );
+        event[16] = 58;
+        assert!(management_frames(&event, 7).is_empty());
+        event[16] = 59;
+        // Corrupt the vendor OUI in the frame attribute.
+        let at = event
+            .windows(5)
+            .position(|b| b == [0x7f, 0, 0x17, 0xf2, 8])
+            .unwrap();
+        event[at + 1] = 1;
+        assert!(management_frames(&event, 7).is_empty());
     }
 }
 

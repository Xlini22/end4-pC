+async fn recv_monitor(fd: &AsyncFd<OwnedFd>, buf: &mut [u8]) -> io::Result<Received> {
+    loop {
+        let mut guard = fd.readable().await?;
+        let read = guard.try_io(|fd| Ok(nix::unistd::read(fd.get_ref(), buf)?));
+        match read {
+            Ok(Ok(n)) => {
+                if let Some(rx) = radiotap::parse(&buf[..n]) {
+                    return Ok(Received {
+                        bytes: rx.frame.to_vec(),
+                        rssi: rx.rssi,
+                    });
+                }
+            }
+            Ok(Err(e)) => {
+                return Err(io::Error::new(
+                    e.kind(),
+                    format!("the monitor interface failed: {e}"),
+                ));
+            }
+            Err(_would_block) => {}
+        }
+    }
+}

+/// ath10k can deliver vendor action frames to nl80211 but omit them from
+/// its monitor socket. Keep the existing AWDL parser and peer validation.
+struct Management {
+    fd: AsyncFd<OwnedFd>,
+    index: u32,
+    buf: Vec<u8>,
+    pending: VecDeque<Received>,
+}
+
+impl Management {
+    fn open(iface: &str) -> io::Result<(OwnedFd, u32)> {
+        use crate::netlink::{Attrs, Genl};
+        use nix::fcntl::{FcntlArg, OFlag, fcntl};
+        let index = if_index(iface)?;
+        let mut socket = Genl::open("nl80211")?;
+        let mut attrs = Attrs::new();
+        attrs
+            .u32(3, index)
+            .u16(101, 0xd0)
+            .bytes(91, &[0x7f, 0, 0x17, 0xf2, 8]);
+        socket.request(58, 0, &attrs)?;
+        let fd = socket.into_fd();
+        let flags = OFlag::from_bits_truncate(fcntl(&fd, FcntlArg::F_GETFL)?);
+        fcntl(&fd, FcntlArg::F_SETFL(flags | OFlag::O_NONBLOCK))?;
+        tracing::info!("receiving AWDL management frames on {iface} via nl80211");
+        Ok((fd, index))
+    }
+
+    async fn recv(&mut self) -> io::Result<Received> {
+        use nix::sys::socket::{NetlinkAddr, recvfrom};
+        loop {
+            if let Some(rx) = self.pending.pop_front() {
+                return Ok(rx);
+            }
+            let mut guard = self.fd.readable().await?;
+            let read = guard.try_io(|fd| {
+                Ok(recvfrom::<NetlinkAddr>(
+                    fd.get_ref().as_raw_fd(),
+                    &mut self.buf,
+                )?)
+            });
+            match read {
+                Ok(Ok((n, Some(sender)))) if sender.pid() == 0 => {
+                    self.pending
+                        .extend(management_frames(&self.buf[..n], self.index));
+                }
+                Ok(Err(e)) => return Err(e),
+                _ => {}
+            }
+        }
+    }
+}
+
+fn management_frames(mut data: &[u8], index: u32) -> Vec<Received> {
+    use crate::netlink::{align, as_u32, attr, u16_at, u32_at};
+    let mut received = Vec::new();
+    while data.len() >= 16 {
+        let len = u32_at(data, 0) as usize;
+        if len < 16 || len > data.len() {
+            break;
+        }
+        let message = &data[..len];
+        if len >= 20 && u16_at(message, 4) >= 16 && message[16] == 59 {
+            let attrs = &message[20..];
+            if attr(attrs, 3).and_then(as_u32) == Some(index)
+                && let Some(frame) = attr(attrs, 51)
+                && frame.len() >= 31
+                && u16_at(frame, 0) & 0x00fc == 0xd0
+                && frame[24..29] == [0x7f, 0, 0x17, 0xf2, 8]
+            {
+                let rssi = attr(attrs, 151)
+                    .and_then(as_u32)
+                    .and_then(|v| i8::try_from(v as i32).ok());
+                received.push(Received {
+                    bytes: frame.to_vec(),
+                    rssi,
+                });
+            }
+        }
+        data = &data[align(len).min(data.len())..];
+    }
+    received
+}

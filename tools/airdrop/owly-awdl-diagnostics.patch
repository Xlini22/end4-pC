+#[cfg(test)]
+mod diagnostic_tests {
+    use super::*;
+
+    #[test]
+    fn samples_are_pre_update_signed_offsets_without_mutating_the_node() {
+        let at = Time(10_000_000);
+        let mac = MacAddr([2, 0, 0, 0, 0, 1]);
+        let radio = crate::RadioConstraints {
+            channel: crate::Channel(6),
+            presence: crate::Presence::Fixed,
+        };
+        let node = Node::new(Config::new(mac, "diagnostic", radio), at);
+        let mut packet = crate::frame::action_frame(mac, 1, 0, 0, |out| {
+            // Sync TLV: one slot ahead (4 AW), next boundary 20 TU away.
+            let mut sync = [0u8; 31];
+            sync[1..3].copy_from_slice(&20u16.to_le_bytes());
+            sync[29..31].copy_from_slice(&4u16.to_le_bytes());
+            out.extend_from_slice(&[4, 31, 0]);
+            out.extend_from_slice(&sync);
+        });
+        let clock = *node.clock();
+        let input = Input::Frame {
+            rx_time: at,
+            rssi: Some(-30),
+            bytes: &packet,
+        };
+        assert_eq!(sync_sample(&node, &input), Some((at, mac, 108)));
+        assert_eq!(*node.clock(), clock);
+        assert!(sync_sample(&node, &Input::Timer(at)).is_none());
+        let length = packet.len();
+        packet[length - 2..].copy_from_slice(&65532u16.to_le_bytes());
+        let behind = Input::Frame {
+            rx_time: at,
+            rssi: Some(-30),
+            bytes: &packet,
+        };
+        assert_eq!(sync_sample(&node, &behind), Some((at, mac, -20)));
+        let malformed = Input::Frame {
+            rx_time: at,
+            rssi: None,
+            bytes: &packet[..packet.len() - 1],
+        };
+        assert!(sync_sample(&node, &malformed).is_none());
+    }
+}

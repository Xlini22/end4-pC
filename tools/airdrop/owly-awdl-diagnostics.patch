+/// Offset against the node's clock BEFORE it receives this announcement.
+fn sync_sample(node: &Node, input: &Input<'_>) -> Option<(Time, MacAddr, i64)> {
+    let Input::Frame { rx_time, bytes, .. } = input else {
+        return None;
+    };
+    let crate::frame::Received::Action { header, tlvs, .. } = crate::frame::parse(bytes).ok()?
+    else {
+        return None;
+    };
+    let sync = crate::tlv::Advert::parse(tlvs).ok()?.sync?;
+    Some((
+        *rx_time,
+        header.src,
+        node.clock()
+            .error_tu(*rx_time, sync.next_tu, sync.aw_counter),
+    ))
+}
 

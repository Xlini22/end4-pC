+//! A selected peer drops its rank and resets its clock between election ticks.
+//! No driver, sockets, radio or backend installation.
+use owly_awdl::election::Election;
+use owly_awdl::frame::{self, subtype};
+use owly_awdl::tlv::{self, Own};
+use owly_awdl::{
+    Channel, Config, Input, MacAddr, Node, Presence, RadioConstraints, Sequence, Time,
+};
+
+fn frame(mac: MacAddr, metric: u32, aw: u16, next: u16, mif: bool) -> Vec<u8> {
+    let sequence = Sequence::fixed(Channel(6));
+    let mut election = Election::own(mac);
+    election.master_metric = metric;
+    election.self_metric = metric;
+    let own = Own {
+        addr: mac,
+        name: "synthetic",
+        devclass: tlv::devclass::IOS,
+        channel: 6,
+        master_channel: Channel(6),
+        next_tu: next,
+        aw_counter: aw,
+        psf_interval_tu: 110,
+        sequence: &sequence,
+        election: &election,
+        ht: None,
+    };
+    frame::action_frame(
+        mac,
+        1,
+        if mif { subtype::MIF } else { subtype::PSF },
+        0,
+        |out| tlv::put_all(out, &own, mif),
+    )
+}
+
+fn feed(node: &mut Node, now: Time, bytes: &[u8]) {
+    node.handle(Input::Frame {
+        rx_time: now,
+        rssi: Some(-30),
+        bytes,
+    })
+    .for_each(drop);
+}
+
+#[test]
+fn a_demoted_sync_peer_cannot_reset_our_clock_before_the_next_tick() {
+    let local = MacAddr([2, 0, 0, 0, 0, 1]);
+    let phone = MacAddr([2, 0, 0, 0, 0, 2]);
+    let other = MacAddr([2, 0, 0, 0, 0, 3]);
+    let start = Time(10_000_000);
+    let radio = RadioConstraints {
+        channel: Channel(6),
+        presence: Presence::Fixed,
+    };
+    let mut node = Node::new(Config::new(local, "repro", radio), start);
+    feed(
+        &mut node,
+        start.plus(100_000),
+        &frame(phone, 513, 400, 64, true),
+    );
+    node.handle(Input::Timer(start.plus(1_000_000)))
+        .for_each(drop);
+    assert_eq!(node.election().sync, phone);
+    feed(
+        &mut node,
+        start.plus(1_100_000),
+        &frame(phone, 513, 456, 20, false),
+    );
+    feed(
+        &mut node,
+        start.plus(1_200_000),
+        &frame(other, 541, 456, 20, true),
+    );
+    node.handle(Input::Timer(start.plus(2_000_000)))
+        .for_each(drop);
+    assert_eq!(node.election().sync, other);
+    feed(
+        &mut node,
+        start.plus(2_100_000),
+        &frame(other, 541, 512, 20, false),
+    );
+
+    let at = start.plus(2_300_000);
+    let before = *node.clock();
+    let updates = node.stats().sync_updates;
+    // The captured peer's analogous PSF drops to metric65 and starts AW6.
+    feed(&mut node, at, &frame(other, 65, 6, 18, false));
+    assert_eq!(node.peer(other).unwrap().election.master_metric, 65);
+    assert_eq!(
+        node.election().sync,
+        phone,
+        "re-rank before adopting a demoted peer's clock"
+    );
+    assert_eq!(
+        *node.clock(),
+        before,
+        "the low-metric peer's reset must not be applied"
+    );
+    assert_eq!(node.stats().sync_updates, updates);
+    let now = start.plus(2_400_000);
+    feed(&mut node, now, &frame(phone, 513, 528, 32, false));
+    assert_eq!(node.clock().error_tu(now, 32, 528), 0);
+    assert_eq!(node.stats().sync_updates, updates + 1);
+    assert_eq!(node.election().sync, phone);
+}

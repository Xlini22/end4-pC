+#[test]
+fn local_pacing_survives_new_inputs_and_respects_channel_windows() {
+    let mut cfg = Config::new(
+        US,
+        "paced",
+        RadioConstraints {
+            channel: Channel(6),
+            presence: Presence::Fixed,
+        },
+    );
+    cfg.unicast_gap_us = 2_000;
+    let mut n = Node::new(cfg, START);
+    let mut channels = [6; SLOTS];
+    channels[3] = 44;
+    let met = meet(&mut n, &seq(channels));
+    feed(
+        &mut n,
+        met,
+        &phone_frame(subtype::PSF, &seq(channels), 456, 64),
+    );
+    let t = met.plus(10_000);
+    let packet = |id| Ipv6Packet::echo_request(US, PHONE, 1, id, b"paced-payload");
+    let count = |a: &[Action]| {
+        transmits(a)
+            .iter()
+            .filter(|f| f.bytes.ends_with(b"paced-payload"))
+            .count()
+    };
+    assert_eq!(
+        count(
+            &n.handle(Input::Outbound {
+                now: t,
+                packet: packet(1)
+            })
+            .collect::<Vec<_>>()
+        ),
+        1
+    );
+    let queued = n
+        .handle(Input::Outbound {
+            now: t,
+            packet: packet(2),
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(count(&queued), 0);
+    assert!(queued.contains(&Action::ArmTimer(t.plus(2_000))));
+    assert_eq!(
+        count(
+            &n.handle(Input::Outbound {
+                now: t.plus(500),
+                packet: packet(3)
+            })
+            .collect::<Vec<_>>()
+        ),
+        0
+    );
+    assert_eq!(count(&tick(&mut n, t.plus(1_999))), 0);
+    assert_eq!(count(&tick(&mut n, t.plus(2_000))), 1);
+    assert_eq!(count(&tick(&mut n, t.plus(3_999))), 0);
+    assert_eq!(count(&tick(&mut n, t.plus(4_000))), 1);
+    // Send just before the guard; the next paced packet must wait through ch44.
+    let edge = t.plus(n.clock().next_slot_us(t) - UNICAST_GUARD_US - 1);
+    assert_eq!(n.clock().slot(edge), 2);
+    assert_eq!(
+        count(
+            &n.handle(Input::Outbound {
+                now: edge,
+                packet: packet(4)
+            })
+            .collect::<Vec<_>>()
+        ),
+        1
+    );
+    assert_eq!(
+        count(
+            &n.handle(Input::Outbound {
+                now: edge,
+                packet: packet(5)
+            })
+            .collect::<Vec<_>>()
+        ),
+        0
+    );
+    assert_eq!(count(&tick(&mut n, edge.plus(2_000))), 0);
+    assert_eq!(count(&tick(&mut n, edge.plus(UNICAST_GUARD_US + 1))), 0);
+    let shared_again = edge.plus(UNICAST_GUARD_US + 1 + SLOT_US + UNICAST_GUARD_US);
+    assert_eq!(n.clock().slot(shared_again), 4);
+    assert_eq!(count(&tick(&mut n, shared_again)), 1);
+}

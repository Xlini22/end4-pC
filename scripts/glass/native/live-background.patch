+std::optional<SGlassOptics> CGlassLayerSurface::optics() const {
+    const auto layer = m_layerSurface.lock();
+    if (!layer || !enhanced()) return std::nullopt;
+    if (layer->m_fadingOut) return m_lastOptics;
+    if (const auto* profile = glassOptics(layer->getPID(), glassProfileKey(layer->m_namespace))) return *profile;
+    return std::nullopt;
+}
+
+const SGlassSurface* CGlassLayerSurface::enhancedSurface() const {
+    const auto layer = m_layerSurface.lock();
+    if (!layer || !enhanced()) return nullptr;
+    if (layer->m_fadingOut) return m_lastSurface ? &*m_lastSurface : nullptr;
+    const SGlassSurface* found = nullptr;
+    for (const auto& surface : g_pGlobalState->glassClients.at(layer->getPID()).surfaces) {
+        if (surface.name != layer->m_namespace || surface.monitor != layer->m_monitor->m_name ||
+            std::abs(surface.width - layer->m_realSize->goal().x) > 2 ||
+            std::abs(surface.height - layer->m_realSize->goal().y) > 2) continue;
+        // ponytail: ambiguous equal-sized windows keep layer optics; unique surface IDs would remove this ceiling.
+        if (found) return nullptr;
+        found = &surface;
+    }
+    return found;
+}
+
+bool CGlassLayerSurface::hasVisibleMaterial() const {
+    const auto* surface = enhancedSurface();
+    if (!surface) return true; // Unknown geometry retains the existing fallback.
+    // Include the antialiased lip at the surface edge; never skip a partially visible opening/closing card.
+    return std::ranges::any_of(surface->regions, [&](const auto& region) {
+        return region.opacity > 0 && region.rect[0] < surface->width + 1 && region.rect[1] < surface->height + 1
+            && region.rect[0] + region.rect[2] > -1 && region.rect[1] + region.rect[3] > -1;
+    });
+}

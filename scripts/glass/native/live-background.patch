@@ -0,0 +1,164 @@
+#pragma once
+
+#include <array>
+#include <algorithm>
+#include <cmath>
+#include <chrono>
+#include <unordered_set>
+#include <optional>
+#include <ranges>
+#include <sstream>
+#include <string>
+#include <string_view>
+#include <vector>
+#include <unordered_map>
+
+inline constexpr int MAX_GLASS_REGIONS = 32;
+struct SGlassRegion {
+    std::array<float, 4> rect{}, radii{}, features{};
+    float edge = 0, opacity = 1, frost = 0;
+    bool operator==(const SGlassRegion&) const = default;
+};
+struct SGlassSurface {
+    std::string name, monitor;
+    float width = 0, height = 0;
+    std::vector<SGlassRegion> regions;
+    bool operator==(const SGlassSurface&) const = default;
+};
+struct SGlassClient {
+    int pid = 0;
+    bool enhanced = false;
+    std::vector<SGlassSurface> surfaces;
+};
+
+inline bool glassSurfaceChanged(const SGlassClient& before, const SGlassClient& after,
+                                std::string_view name, std::string_view monitor) {
+    if (before.enhanced != after.enhanced) return true;
+    const auto matches = [&](const SGlassSurface& surface) { return surface.name == name && surface.monitor == monitor; };
+    return !std::ranges::equal(before.surfaces | std::views::filter(matches), after.surfaces | std::views::filter(matches));
+}
+
+inline std::optional<std::array<float, 4>> glassBounds(const SGlassSurface& surface, bool frostedOnly = false) {
+    float left = surface.width, top = surface.height, right = 0, bottom = 0;
+    for (const auto& region : surface.regions) {
+        if (region.opacity <= 0 || (frostedOnly && region.frost <= 0)) continue;
+        left = std::min(left, region.rect[0]);
+        top = std::min(top, region.rect[1]);
+        right = std::max(right, region.rect[0] + region.rect[2]);
+        bottom = std::max(bottom, region.rect[1] + region.rect[3]);
+    }
+    left = std::clamp(left, 0.0f, surface.width);
+    top = std::clamp(top, 0.0f, surface.height);
+    right = std::clamp(right, 0.0f, surface.width);
+    bottom = std::clamp(bottom, 0.0f, surface.height);
+    if (right <= left || bottom <= top) return std::nullopt;
+    return std::array<float, 4>{left, top, right - left, bottom - top};
+}
+
+// Parse into a temporary: a malformed IPC message must never replace the last valid geometry.
+inline bool parseGlassRegions(const std::string& request, SGlassClient& result) {
+    if (request.size() > 32768) return false;
+    std::istringstream input(request);
+    std::string command, extra;
+    int enabled = 0, count = 0;
+    SGlassClient client;
+    if (!(input >> command >> client.pid >> enabled >> count) || command != "end4glass" || client.pid <= 0 ||
+        (enabled < 0 || enabled > 2) || count < 0 || count > 32) return false;
+    client.enhanced = enabled;
+    for (int i = 0; i < count; ++i) {
+        SGlassSurface surface;
+        int regions = 0;
+        if (!(input >> surface.name >> surface.monitor >> surface.width >> surface.height >> regions) ||
+            surface.name.size() > 128 || !surface.name.starts_with("quickshell:") || surface.monitor.size() > 128 ||
+            !std::isfinite(surface.width) || !std::isfinite(surface.height) || surface.width <= 0 || surface.height <= 0 ||
+            surface.width > 32768 || surface.height > 32768 || regions < 0 || regions > MAX_GLASS_REGIONS) return false;
+        for (int j = 0; j < regions; ++j) {
+            SGlassRegion region;
+            for (auto* values : {&region.rect, &region.radii, &region.features})
+                for (float& value : *values)
+                    if (!(input >> value) || !std::isfinite(value) || std::abs(value) > 65536) return false;
+            if (!(input >> region.edge >> region.opacity) || !std::isfinite(region.edge) || region.edge < 0 || region.edge > 3 || !std::isfinite(region.opacity) || region.opacity < 0 || region.opacity > 1 ||
+                region.rect[2] <= 0 || region.rect[3] <= 0) return false;
+            if (enabled == 2 && (!(input >> region.frost) || !std::isfinite(region.frost) || region.frost < 0 || region.frost > 32)) return false;
+            for (float r : region.radii) if (r < 0 || r > std::min(region.rect[2], region.rect[3]) * .5f) return false;
+            for (float feature : region.features) if (feature < 0 || feature > 32768) return false;
+            surface.regions.push_back(region);
+        }
+        client.surfaces.push_back(std::move(surface));
+    }
+    if (input >> extra) return false;
+    result = std::move(client);
+    return true;
+}
+
+
+struct SGlassOptics {
+    bool enabled = true;
+    float rim = .07f, refraction = 1.35f, blur = 0, reflections = .5f;
+    float darkening = 0, automaticDarkening = 0;
+    std::array<float, 2> darkeningFrom{};
+    std::chrono::steady_clock::time_point darkeningChanged{};
+    bool darkeningTransition() const {
+        return std::chrono::steady_clock::now() - darkeningChanged < std::chrono::milliseconds(800);
+    }
+    std::array<float, 2> darkeningValue() const {
+        float t = std::clamp(std::chrono::duration<float>(std::chrono::steady_clock::now() - darkeningChanged).count() / .8f, 0.0f, 1.0f);
+        t = t * t * (3 - 2 * t);
+        return {darkeningFrom[0] + (darkening - darkeningFrom[0]) * t,
+                darkeningFrom[1] + (automaticDarkening - darkeningFrom[1]) * t};
+    }
+};
+struct SGlassProfiles {
+    int pid = 0;
+    bool active = false;
+    bool darkeningActive = false;
+    std::unordered_map<std::string, SGlassOptics> values;
+};
+inline std::string glassProfileKey(std::string_view name) {
+    if (name == "quickshell:bar" || name == "quickshell:verticalBar") return "bar";
+    if (name == "quickshell:dock") return "dock";
+    if (name == "quickshell:sidebarLeft" || name == "quickshell:sidebarRight") return "sidebar";
+    if (name == "quickshell:settings" || name == "quickshell:dashboard") return "settings";
+    return "";
+}
+inline bool parseGlassProfiles(const std::string& request, SGlassProfiles& result) {
+    if (request.size() > 4096) return false;
+    std::istringstream input(request);
+    std::string command, key, extra;
+    int active = 0, count = 0;
+    SGlassProfiles profiles;
+    if (!(input >> command >> profiles.pid >> active >> count) || command != "end4profiles" ||
+        profiles.pid <= 0 || active < 0 || active > 1 || count < 0 || count > 6) return false;
+    profiles.active = active;
+    for (int i = 0; i < count; ++i) {
+        SGlassOptics optics;
+        int enabled = 0;
+        if (!(input >> key >> enabled >> optics.rim >> optics.refraction >> optics.blur >> optics.reflections) ||
+            (key != "bar" && key != "dock" && key != "sidebar" && key != "settings" && key != "lockscreen" && key != "terminal") ||
+            profiles.values.contains(key) || enabled < 0 || enabled > 1 ||
+            !std::isfinite(optics.rim) || optics.rim < 0 || optics.rim > .4f ||
+            !std::isfinite(optics.refraction) || optics.refraction < 0 || optics.refraction > 2 ||
+            !std::isfinite(optics.blur) || optics.blur < 0 || optics.blur > 16 ||
+            ((key == "bar" || key == "terminal") && optics.blur > 8) ||
+            !std::isfinite(optics.reflections) || optics.reflections < 0 || optics.reflections > 1) return false;
+        optics.enabled = enabled;
+        profiles.values.emplace(key, optics);
+    }
+    if (input >> extra) {
+        int enabled = 0;
+        if (extra != "darkening" || !(input >> enabled) || enabled < 0 || enabled > 1) return false;
+        profiles.darkeningActive = enabled;
+        std::unordered_set<std::string> seen;
+        for (int i = 0; i < count; ++i) {
+            float darkness = 0;
+            int automatic = 0;
+            if (!(input >> key >> darkness >> automatic) || !profiles.values.contains(key) || !seen.insert(key).second ||
+                !std::isfinite(darkness) || darkness < 0 || darkness > 1 || automatic < 0 || automatic > 1) return false;
+            profiles.values.at(key).darkening = darkness;
+            profiles.values.at(key).automaticDarkening = automatic;
+        }
+        if (input >> extra) return false;
+    }
+    result = std::move(profiles);
+    return true;
+}

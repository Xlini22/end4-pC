diff --git a/src/GlassRegions.hpp b/src/GlassRegions.hpp
new file mode 100644
index 0000000..07d787a
--- /dev/null
+++ b/src/GlassRegions.hpp
@@ -0,0 +1,78 @@
+#pragma once
+
+#include <array>
+#include <algorithm>
+#include <cmath>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <vector>
+
+inline constexpr int MAX_GLASS_REGIONS = 32;
+struct SGlassRegion {
+    std::array<float, 4> rect{}, radii{}, features{};
+    float edge = 0, opacity = 1, frost = 0;
+};
+struct SGlassSurface {
+    std::string name, monitor;
+    float width = 0, height = 0;
+    std::vector<SGlassRegion> regions;
+};
+struct SGlassClient {
+    int pid = 0;
+    bool enhanced = false;
+    std::vector<SGlassSurface> surfaces;
+};
+
+inline std::optional<std::array<float, 4>> glassBounds(const SGlassSurface& surface, bool frostedOnly = false) {
+    float left = surface.width, top = surface.height, right = 0, bottom = 0;
+    for (const auto& region : surface.regions) {
+        if (region.opacity <= 0 || (frostedOnly && region.frost <= 0)) continue;
+        left = std::min(left, region.rect[0]);
+        top = std::min(top, region.rect[1]);
+        right = std::max(right, region.rect[0] + region.rect[2]);
+        bottom = std::max(bottom, region.rect[1] + region.rect[3]);
+    }
+    left = std::clamp(left, 0.0f, surface.width);
+    top = std::clamp(top, 0.0f, surface.height);
+    right = std::clamp(right, 0.0f, surface.width);
+    bottom = std::clamp(bottom, 0.0f, surface.height);
+    if (right <= left || bottom <= top) return std::nullopt;
+    return std::array<float, 4>{left, top, right - left, bottom - top};
+}
+
+// Parse into a temporary: a malformed IPC message must never replace the last valid geometry.
+inline bool parseGlassRegions(const std::string& request, SGlassClient& result) {
+    if (request.size() > 32768) return false;
+    std::istringstream input(request);
+    std::string command, extra;
+    int enabled = 0, count = 0;
+    SGlassClient client;
+    if (!(input >> command >> client.pid >> enabled >> count) || command != "end4glass" || client.pid <= 0 ||
+        (enabled < 0 || enabled > 2) || count < 0 || count > 32) return false;
+    client.enhanced = enabled;
+    for (int i = 0; i < count; ++i) {
+        SGlassSurface surface;
+        int regions = 0;
+        if (!(input >> surface.name >> surface.monitor >> surface.width >> surface.height >> regions) ||
+            surface.name.size() > 128 || !surface.name.starts_with("quickshell:") || surface.monitor.size() > 128 ||
+            !std::isfinite(surface.width) || !std::isfinite(surface.height) || surface.width <= 0 || surface.height <= 0 ||
+            surface.width > 32768 || surface.height > 32768 || regions < 0 || regions > MAX_GLASS_REGIONS) return false;
+        for (int j = 0; j < regions; ++j) {
+            SGlassRegion region;
+            for (auto* values : {&region.rect, &region.radii, &region.features})
+                for (float& value : *values)
+                    if (!(input >> value) || !std::isfinite(value) || std::abs(value) > 65536) return false;
+            if (!(input >> region.edge >> region.opacity) || !std::isfinite(region.edge) || region.edge < 0 || region.edge > 3 || !std::isfinite(region.opacity) || region.opacity < 0 || region.opacity > 1 ||
+                region.rect[2] <= 0 || region.rect[3] <= 0) return false;
+            if (enabled == 2 && (!(input >> region.frost) || !std::isfinite(region.frost) || region.frost < 0 || region.frost > 32)) return false;
+            for (float r : region.radii) if (r < 0 || r > std::min(region.rect[2], region.rect[3]) * .5f) return false;
+            for (float feature : region.features) if (feature < 0 || feature > 32768) return false;
+            surface.regions.push_back(region);
+        }
+        client.surfaces.push_back(std::move(surface));
+    }
+    if (input >> extra) return false;
+    result = std::move(client);
+    return true;
+}

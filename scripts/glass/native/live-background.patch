+std::string CGlassLayerSurface::contrastSample() {
+    const auto layer = m_layerSurface.lock();
+    if (!layer || layer->m_fadingOut || layer->m_namespace != "quickshell:settings" || !enhanced()) return "null";
+    const auto now = std::chrono::steady_clock::now();
+    // One wakeup on subscription; polling an idle panel must not force continuous redraws.
+    if (now - m_contrastRequested > std::chrono::seconds(2) || m_contrastFence)
+        g_pHyprRenderer->damageBox(CBox{layer->m_realPosition->value(), layer->m_realSize->value()});
+    m_contrastRequested = now;
+    if (m_contrastReady.time_since_epoch().count() == 0 || m_contrastFailed) return "null";
+    const auto& monitor = layer->m_monitor->m_name;
+    if (std::ranges::any_of(monitor, [](unsigned char c) { return c < 32; })) return "null";
+    std::ostringstream output;
+    output << "{\"name\":\"quickshell:settings\",\"monitor\":" << std::quoted(monitor)
+        << ",\"width\":" << layer->m_realSize->value().x << ",\"height\":" << layer->m_realSize->value().y << ",\"rect\":[";
+    for (size_t i = 0; i < m_contrastBox.size(); ++i) output << (i ? "," : "") << m_contrastBox[i];

+void CGlassLayerSurface::sampleContrast(const SP<Render::IFramebuffer>& source, CBox box, const SGlassSurface& surface) {
+    using namespace std::chrono;
+    const auto now = steady_clock::now();
+    if (m_contrastFailed || now - m_contrastRequested > seconds(2) ||
+        (!m_contrastFence && now - m_contrastStarted < milliseconds(250))) return;
+    GLint readFB = 0, drawFB = 0, buffer = 0, alignment = 0, rowLength = 0, skipRows = 0, skipPixels = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &readFB);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &drawFB);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &buffer);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &alignment);
+    glGetIntegerv(GL_PACK_ROW_LENGTH, &rowLength);
+    glGetIntegerv(GL_PACK_SKIP_ROWS, &skipRows);
+    glGetIntegerv(GL_PACK_SKIP_PIXELS, &skipPixels);
+    const auto restore = Hyprutils::Utils::CScopeGuard([&] {
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, readFB);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, drawFB);
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, buffer);
+        glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+        glPixelStorei(GL_PACK_ROW_LENGTH, rowLength);
+        glPixelStorei(GL_PACK_SKIP_ROWS, skipRows);
+        glPixelStorei(GL_PACK_SKIP_PIXELS, skipPixels);
+    });
+    if (m_contrastFence) {
+        // Never wait on the GPU; a late sample keeps the previous text colours.
+        const auto state = glClientWaitSync(m_contrastFence, 0, 0);
+        if (state == GL_TIMEOUT_EXPIRED) return;
+        if (state == GL_WAIT_FAILED) { m_contrastFailed = true; return; }
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, m_contrastBuffer);
+        const auto* pixels = static_cast<const unsigned char*>(glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0, 32 * 24 * 4, GL_MAP_READ_BIT));
+        if (!pixels) { m_contrastFailed = true; return; }
+        const auto linear = [](unsigned char c) { const float v = c / 255.0f; return v <= .04045f ? v / 12.92f : std::pow((v + .055f) / 1.055f, 2.4f); };
+        for (size_t i = 0; i < m_contrastLuma.size(); ++i)
+            m_contrastLuma[i] = std::clamp(std::lround(255 * (.2126f * linear(pixels[i * 4]) + .7152f * linear(pixels[i * 4 + 1]) + .0722f * linear(pixels[i * 4 + 2]))), 0l, 255l);
+        const bool valid = glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+        glDeleteSync(m_contrastFence); m_contrastFence = nullptr;
+        if (!valid) { m_contrastFailed = true; return; }
+        m_contrastBox = m_contrastPendingBox;
+        m_contrastReady = now;
+        return;
+    }
+    if (now - m_contrastStarted < milliseconds(250)) return;
+    const auto bounds = glassBounds(surface);
+    if (!bounds) return;
+    const auto [x, y, w, h] = *bounds;
+    const double sx = box.w / surface.width, sy = box.h / surface.height;
+    CBox sample{box.x + x * sx, box.y + y * sy, w * sx, h * sy};
+    sample = sample.intersection(CBox{0, 0, source->m_size.x, source->m_size.y});
+    sample.round();
+    if (sample.w <= 0 || sample.h <= 0) return;
+    m_contrastPendingBox = {float((sample.x - box.x) / sx), float((sample.y - box.y) / sy), float(sample.w / sx), float(sample.h / sy)};
+    if (!m_contrastFramebuffer) m_contrastFramebuffer = g_pHyprRenderer->createFB("hyprglass-contrast");
+    if (m_contrastFramebuffer->m_size != Vector2D(32, 24) && !m_contrastFramebuffer->alloc(32, 24, DRM_FORMAT_ABGR8888)) {
+        m_contrastFailed = true; return;
+    }
+    if (!m_contrastBuffer) {
+        glGenBuffers(1, &m_contrastBuffer);
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, m_contrastBuffer);
+        glBufferData(GL_PIXEL_PACK_BUFFER, 32 * 24 * 4, nullptr, GL_STREAM_READ);
+    }
+    g_pHyprOpenGL->setCapStatus(GL_SCISSOR_TEST, false);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, dynamic_cast<Render::GL::CGLFramebuffer*>(source.get())->getFBID());
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, dynamic_cast<Render::GL::CGLFramebuffer*>(m_contrastFramebuffer.get())->getFBID());
+    glBlitFramebuffer(sample.x, sample.y, sample.x + sample.w, sample.y + sample.h, 0, 0, 32, 24, GL_COLOR_BUFFER_BIT, GL_LINEAR);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, dynamic_cast<Render::GL::CGLFramebuffer*>(m_contrastFramebuffer.get())->getFBID());
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, m_contrastBuffer);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1); glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_PACK_SKIP_ROWS, 0); glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    glReadPixels(0, 0, 32, 24, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    m_contrastFence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    if (!m_contrastFence) { m_contrastFailed = true; return; }
+    glFlush();
+    m_contrastStarted = now;
+    // Complete the asynchronous read on a later frame, including on a static desktop.
+    if (const auto layer = m_layerSurface.lock())
+        g_pHyprRenderer->damageBox(CBox{layer->m_realPosition->value(), layer->m_realSize->value()});
+}
+
+bool CGlassLayerSurface::enhanced() const {
+    const auto layer = m_layerSurface.lock();
+    if (!layer || !layer->m_monitor || layer->m_monitor->m_transform != WL_OUTPUT_TRANSFORM_NORMAL) return false;
+    if (layer->m_fadingOut) return m_lastEnhanced;
+    const auto it = g_pGlobalState->glassClients.find(layer->getPID());
+    return it != g_pGlobalState->glassClients.end() && it->second.enhanced;
+}
+
+const SGlassSurface* CGlassLayerSurface::enhancedSurface() const {
+    const auto layer = m_layerSurface.lock();
+    if (!layer || !enhanced()) return nullptr;
+    if (layer->m_fadingOut) return m_lastSurface ? &*m_lastSurface : nullptr;
+    const SGlassSurface* found = nullptr;
+    for (const auto& surface : g_pGlobalState->glassClients.at(layer->getPID()).surfaces) {
+        if (surface.name != layer->m_namespace || surface.monitor != layer->m_monitor->m_name ||
+            std::abs(surface.width - layer->m_realSize->goal().x) > 2 ||
+            std::abs(surface.height - layer->m_realSize->goal().y) > 2) continue;
+        // ponytail: ambiguous equal-sized windows keep layer optics; unique surface IDs would remove this ceiling.
+        if (found) return nullptr;
+        found = &surface;
+    }
+    return found;
+}
